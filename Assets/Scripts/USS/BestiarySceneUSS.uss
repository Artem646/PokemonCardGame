.top-bar {
    width: 100%;
    height: 13%;
    flex-direction: row;
    justify-content: space-evenly;
    align-items: center;
    background-color: rgb(17, 26, 40);
    border-color: rgb(255, 255, 255);
    border-bottom-width: 2px;
}

.nav-buttons {
    width: 76.5%;
    height: 78%;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    padding-right: 5%;
}

.nav-button {
    width: 15%;
    height: 100%;
    background-color: transparent;
    border-width: 0;
    padding: 0;
}

.nav-button_text {
    width: 100%;
    height: 100%;
    font-size: 30px;
    color: var(--top-nav-button-text-color);
    margin: 0;
    padding: 0;
}

.overlay {
    position: absolute; 
    justify-content: center; 
    align-items: center; 
    background-color: rgba(0, 0, 0, 0.39); 
    top: 0; 
    left: 0; 
    right: 0; 
    bottom: 0; 
}

.overlay-none {
    display: none;
}

.overlay-active {
    display: flex;
}