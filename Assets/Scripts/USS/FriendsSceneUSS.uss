.main-content {
    width: 100%;
    height: 100%;
    flex-direction: row;
    justify-content: flex-start;
    align-items: stretch;
    background-color: var(--bg-main);
    flex-grow: 1;
    padding: 15px;
}

#unity-content-container {
    flex-direction: row;
    justify-content: flex-start;
    align-content: flex-start;
    flex-wrap: wrap;
}

.add-friend-button-container {
    width: 16%; 
    height: 100%; 
    justify-content: flex-end; 
    align-items: center; 
    left: 1%;
}

.add-friend-button {
    width: 100%; 
    height: 60%; 
    background-color: var(--bg-add-friend-button);
    font-size: 51px; 
    white-space: normal; 
    color: var(--add-friend-button-text-color);
    border-width: 2px; 
    border-radius: 50px; 
    margin: 0; 
    padding-right: 20px; 
    padding-left: 20px; 
    bottom: 25px; 
}