.friend {
    width: 100%;
    height: 100%;
    position: relative;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    flex-shrink: 1;
    background-color: var(--bg-friend);
    margin: 0;
    padding: 10px;
}

.top-friend-panel {
    width: 100%;
    height: 30%;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: var(--bg-top-friend-panel);
    border-top-right-radius: 20px;
    border-top-left-radius: 20px;
}

.edit-friend-button {
    width: 300px;
    height: 70px;
    background-color: var(--bg-edit-friend-button);
    font-size: 27px;
    color: var(--edit-friend-button-text-color);
    border-radius: 15px;
    border-width: 3px;
    margin: 0;
    padding: 0;
    right: 20px;
}

.delete-friend-button {
    width: 300px;
    height: 70px;
    background-color: var(--bg-delete-friend-button); 
    font-size: 27px;
    color: var(--delete-friend-button-text-color); 
    border-width: 3px;
    border-radius: 15px;
    margin: 0;
    padding: 0;
}

.content-container {
    width: 100%;
    height: 70%;
    flex-direction: row;
    justify-content: space-evenly;
    align-items: center;
    background-color: var(--content-container);
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
}

.update-photo-button {
    width: 7%;
    height: 90%;
    background-color: var(--bg-update-photo-button);
    font-size: 30px;
    color: var(--update-photo-button-text-color);
    border-radius: 20px;
    margin: 0;
    margin-left: 25px;
    padding: 0;
}

.update-photo-button-label {
    height: 100%;
    rotate: -90deg;
    font-size: 30px;
    -unity-text-align: middle-center;
    margin: 0;
    padding: 0;
}

.friend-image {
    width: 20%;
    height: 90%;
    justify-content: space-evenly;
    align-items: center;
    border-width: 2px;
    border-color: rgb(193, 116, 116);
    background-color: rgb(0, 0, 0);
    border-top-left-radius: 90px;
    border-top-right-radius: 90px;
    border-bottom-right-radius: 27px;
    border-bottom-left-radius: 27px;
    margin-left: 22px;
}

.info-name-panel {
    width: 68%;
    height: 90%;
    justify-content: center;
    align-items: center;
}

.nickname {
    width: 100%;
    height: 30%; 
    font-size: 40px; 
    -unity-text-align: middle-center; 
    color: var(--nickname-label-text-color);
    margin: 0; 
    padding: 0; 
}

.friend-name {
    width: 100%; 
    height: 50%; 
    font-size: 50px;
    -unity-text-align: middle-center;
    color: var(--friend-name-text-color);
    margin: 0;
    padding: 0;
}
