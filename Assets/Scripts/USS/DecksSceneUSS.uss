.main-content {
    width: 100%;
    height: 100%;
    flex-direction: row;
    justify-content: flex-start;
    align-items: flex-start; 
    background-color: var(--bg-main);
    flex-grow: 1; 
    padding: 0; 
}

#unity-content-container {
    flex-direction: row;
    justify-content: flex-start;
    align-content: flex-start;
    flex-wrap: wrap;
}

.add-deck-button-container {
    width: 16%; 
    height: 100%; 
    justify-content: flex-end; 
    align-items: center; 
    left: 1%;
}

.add-deck-button {
    width: 100%; 
    height: 60%; 
    background-color: var(--bg-add-deck-button);
    font-size: 51px; 
    white-space: normal; 
    color: var(--add-deck-button-text-color);
    border-width: 2px; 
    border-radius: 50px; 
    margin: 0; 
    padding-right: 20px; 
    padding-left: 20px; 
    bottom: 25px; 
}

.overlay {
    width: 100%; 
    height: 100%; 
    position: absolute; 
    flex-direction: row;
    justify-content: center; 
    align-items: center; 
    background-color: rgba(0, 0, 0, 0.39); 
}

.overlay-none {
    display: none;
}

.overlay-active {
    display: flex;
}