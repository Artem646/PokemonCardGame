.overlay {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.49);
    display: none;
}

.deck-editor {
    width: 70%;
    height: 80%;
    justify-content: center;
    align-items: center;
    background-color: rgb(40, 40, 40);
    border-radius: 50px;
    padding: 15px;
}

.deck-title {
    width: 100%;
    height: 10%;
    margin: 0;
}

#unity-text-input {
    height: 100%;
    text-align: center;
    -unity-text-align: middle-center;
    font-size: 35px;
    color: rgb(255, 255, 255);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 0;
    padding: 0;
}

.deck-cards-scroll {
    width: 100%;
    height: 100%;
    background-color: rgb(60, 60, 60);
    border-radius: 5px;
    padding: 1%;
}

#unity-content-container {
    width: 100%;
    height: 100%;
}

.cards-container {
    width: 100%;
    height: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-evenly;
    align-items: center;
}

.action-button {
    width: 40%;
    height: 9.5%;
    background-color: rgb(221, 187, 55);
    font-size: 30px;
    border-width: 2px;
    border-radius: 20px;
    margin: 0;
    margin-top: 1%;
    padding: 0;
}

.close-button {
    width: 4.5%;
    height: 90%;
    background-color: rgb(161, 63, 63);
    background-image: url("project://database/Assets/Photon/Fusion/Runtime/Statistics/StatsIcons/FusionStatsCancelIcon.png?fileID=2800000&guid=5853bc00e6bfda84ea9030e0486a1c44&type=3#FusionStatsCancelIcon");
    background-size: 90% 90%;
    border-radius: 20px;
    margin: 0;
    padding: 0;
    right: 1%;
}
