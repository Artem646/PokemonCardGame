    <ui:VisualElement name="overlay" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.49); display: none; align-items: center; justify-content: center;">
        <ui:VisualElement name="settings" style="flex-direction: column; align-items: center; justify-content: flex-start; width: 1407px; height: 482px; margin: auto; background-color: rgb(40, 40, 40); border-radius: 10px; padding: 15px; position: relative; top: auto; left: auto; border-top-left-radius: 50px; border-top-right-radius: 50px; border-bottom-right-radius: 50px; border-bottom-left-radius: 50px; display: flex; align-self: auto;">
