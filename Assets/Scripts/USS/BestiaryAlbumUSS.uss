.main-content {
    width: 100%;
    height: 87%;
    background-color: rgb(20, 30, 45);
    justify-content: center;
    align-items: center;
}

.album-scroll {
    width: 95%;
    height: 90%;
}

.spread {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    flex-direction: row;
}

.album-page {
    width: 50%;
    height: 100%;
    flex-shrink: 0;
    position: absolute;
    top: 0;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    align-items: flex-start;
    align-content: flex-start;
    padding-top: 0.5%;
    background-color: rgb(14, 45, 80);
}

#coverPage {
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    padding: 0;
}

#filters {
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
    padding: 0;
    border-radius: 30px;
    width: 45%;
}

.left-page {
    left: 0;
    transform-origin: 100% 50%;
    border-top-left-radius: 30px;
    border-bottom-left-radius: 30px;
    padding-left: 3.2%;
    padding-right: 0.2%;
}

.right-page {
    right: 0;
    transform-origin: 0% 50%;
    border-top-right-radius: 30px;
    border-bottom-right-radius: 30px;
    padding-left: 3.5%;
}

.editor-middle-panel {
    width: 6%;
    height: 78.25%;
    align-items: center;
    justify-content: center;
    flex-direction: row;
    position: absolute;
    left: 46.85%;
    top: 17.4%;
    display: none;
}

.editor-middle-element {
    border-right-width: 5px;
    border-right-color: rgba(0, 0, 0, 0.4);
    border-left-width: 5px;
    border-left-color: rgba(255, 255, 255, 0.1);
    width: 30%;
    height: 100%;
}

.middle-element {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 33%;
    height: 100%;
}

.left-page .middle-element {
    border-left-width: 5px;
    border-left-color: rgba(0, 0, 0, 0.4);
    right: 0;
}

.right-page .middle-element {
    border-right-width: 5px;
    border-right-color: rgba(255, 255, 255, 0.1);
    left: 0;
}

#coverPage .middle-element {
    width: 0;
}

.editor-rings-container {
    position: absolute;
    height: 100%;
    width: 100%;
    justify-content: space-around;
    align-items: center;
}

.rings-container {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 6%;
    height: 100%;
    flex-direction: column;
    justify-content: space-around;
    align-items: center;
}

.left-page .rings-container {
    right: 0;
}

.right-page .rings-container {
    left: 0;
}

.editor-ring-image {
    width: 100%;
    height: 4%;
    background-image: resource("Sprites/fullRing");
}

.ring-image {
    width: 100%;
    height: 4%;
    flex-shrink: 0;
}

.left-page .ring-image {
    background-image: resource("Sprites/leftRing");
}

.right-page .ring-image {
    background-image: resource("Sprites/rightRing");
}

.album-nav-buttons {
    flex-grow: 0;
    flex-direction: row;
    height: 78%;
    width: 23.5%;
    align-items: center;
    justify-content: space-between;
    left: auto;
    margin-left: 0%;
    padding-left: 5%;
}

.album-nav-button {
    width: 47%;
    height: 100%;
    font-size: 50px;
    background-color: rgb(0, 209, 197);
    color: white;
    border-radius: 10px;
    border-width: 2px;
    margin: 10px 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
}

.page-number-label {
    position: absolute;
    bottom: 3px;
    width: 93%;
    -unity-text-align: middle-center;
    font-size: 20px;
    color: rgba(255, 255, 255, 0.5);
    -unity-font-style: bold;
}

.left-page .page-number-label {
    left: 0;
}

.right-page .page-number-label {
    right: 0;
}

.shadow-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: black;
    opacity: 0;
}

.filters-label-container {
    width: 90%;
    height: 14%;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    margin: 3.5% 0 0 0;
}

.filters-label {
    width: 45%;
    height: 100%;
    justify-content: flex-start;
    align-items: stretch;
    color: rgb(143, 224, 66);
    font-size: 45px;
    -unity-text-align: middle-center;
    border-width: 2px;
    border-radius: 25px;
    border-color: rgb(106, 172, 110);
    margin: 0;
    padding: 0;
}

.filters-container {
    width: 90%;
    height: 70%;
    top: 4.5%;
}

.elements-container {
    width: 100%;
    height: 52.3%;
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    flex-wrap: wrap;
    background-color: rgb(28, 36, 51);
    border-radius: 50px;
    padding: 1%;
}

.element-wrapper {
    justify-content: center;
    align-items: center;
    margin: 5px 10px;
}

.element-icon {
    width: 100px;
    height: 100px;
    border-width: 2px;
    border-radius: 50px;
    border-color: rgb(0, 209, 197);
    padding: 0;
    margin: 0;
    background-color: rgba(0, 0, 0, 0);
}

.element-name {
    color: rgb(0, 209, 197);
    font-size: 19px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.5);
    padding: 4px 1px;
    margin: 2px;
    margin-top: 5px;
}

.bestiary-label-container {
    width: 90%;
    height: 14%;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    margin-top: 3.5% 0 0 0;
}

.bestiary-label {
    width: 45%;
    height: 100%;
    align-items: stretch;
    justify-content: flex-start;
    color: rgb(143, 224, 66);
    font-size: 45px;
    -unity-text-align: middle-center;
    border-color: rgb(106, 172, 110);
    border-width: 2px;
    border-radius: 25px;
    margin: 0;
    padding: 0;
}

.cover-spread-images {
    width: 90%;
    height: 70%;
    margin-top: 4.5%;
    margin-left: 3%;
}

.first-image {
    width: 30%;
    height: 50%;
    position: absolute;
    top: 19px;
    left: 37px;
    rotate: -16deg;
    background-image: resource("Sprites/PokemonImages/Bulbasaur");
    border-width: 5px;
    border-color: rgb(163, 38, 77);
    background-size: 88% 85%;
    border-radius: 20px;
    translate: 19% -3%;
    background-color: rgb(0, 0, 0);
}

.second-image {
    width: 30%;
    height: 50%;
    position: absolute;
    top: 22px;
    left: 701px;
    rotate: 22deg;
    background-image: resource("Sprites/PokemonImages/Blastoise");
    border-width: 5px;
    border-color: rgb(163, 38, 77);
    background-size: 88% 85%;
    border-radius: 20px;
    translate: -4% 0;
    background-color: rgb(0, 0, 0);
}

.third-image {
    width: 32%;
    height: 50%;
    position: absolute;
    top: 301px;
    left: 376px;
    background-image: resource("Sprites/PokemonImages/Cubone");
    border-width: 5px;
    border-color: rgb(163, 38, 77);
    background-size: 88% 85%;
    border-radius: 20px;
    background-color: rgb(0, 0, 0);
}