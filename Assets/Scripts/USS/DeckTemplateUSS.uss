.deck {
    width: 100%;
    height: 459px;
    position: relative;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    flex-shrink: 1;
    background-color: var(--bg-deck);
    margin: 0;
    padding: 10px;
}

.top-deck-panel-container {
    width: 100%;
    height: 25%;
    flex-direction: row;
    justify-content: center;
    background-color: var(--bg-top-deck-panel);
    border-top-right-radius: 20px;
    border-top-left-radius: 20px;
}

.top-deck-panel {
    width: 100%; 
    height: 100%; 
    flex-direction: row; 
    justify-content: center; 
    align-items: center;
}

.deck-name-label-container {
    width: 70%; 
    height: 100%; 
    flex-direction: row; 
    justify-content: flex-start; 
    align-items: center; 
    align-self: stretch;
}

.deck-name-label {
    justify-content: flex-end;
    align-items: center; 
    font-size: 50px; 
    color: var(--deck-name-text-color);
    margin: 0; 
    padding: 0; 
    left: 5%; 
}

.buttons-panel {
    width: 40%;
    height: 100%; 
    flex-direction: row; 
    align-items: center; 
}

.edit-deck-button {
    width: 300px; 
    height: 70px; 
    background-color: var(--bg-edit-deck-button);
    font-size: 27px; 
    color: var(--edit-deck-button-text-color); 
    border-radius: 15px; 
    border-width: 3px; 
    margin: 0; 
    margin-right: 40px; 
    padding: 0; 
}

.delete-deck-button {
    width: 300px; 
    height: 70px; 
    background-color: var(--bg-delete-deck-button); 
    font-size: 27px; 
    color: var(--delete-deck-button-text-color); 
    border-width: 3px; 
    border-radius: 15px; 
    margin: 0; 
    padding: 0; 
}

.deck-cards-container {
    width: 100%; 
    height: 360px; 
    flex-direction: row; 
    justify-content: center; 
    align-items: center; 
    background-color: var(--bg-deck-cards-container);
    border-bottom-right-radius: 20px; 
    border-bottom-left-radius: 20px;
}
