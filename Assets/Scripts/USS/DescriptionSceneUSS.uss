.top-bar {
    height: 16%;
    flex-direction: row;
    align-items: center;
    justify-content: space-evenly;
    background-color: rgb(17, 26, 40);
    padding: 0.4% 0.8% 0.4% 2.5%;
}

.nav-buttons {
    width: 100%;
    height: 80%;
    flex-direction: row;
    justify-content: space-between;
    margin-left: 0;
    margin-right: 50px;
}

.nav-button {
    width: 13%;
    min-width: 100px;
    min-height: 40px;
    background-color: transparent;
    border-width: 0;
    padding: 0;
}

.nav-button_text {
    width: 100%;
    height: 100%;
    font-size: 34px;
    color: var(--top-nav-button-text-color);
    white-space: normal;
    margin: 0;
    padding: 0;
}

.pokemon-name {
    width: 27%;
    height: 68%;
    position: absolute;
    top: 25px;
    left: 908px;
    color: rgb(143, 224, 66);
    font-size: 45px;
    -unity-text-align: middle-center;
    border-width: 2px;
    border-color: rgb(106, 172, 110);
    margin: 1px 0;
    padding: 0;
}

.main-content {
    width: 100%;
    height: 84%;
    flex-direction: row;
    background-color:rgb(14, 20, 32);
}

.card-panel {
    width: 30%;
    height: 100%;
    justify-content: center;
    align-items: center;
}

.info-panel {
    width: 75%;
    height: 100%;
}

#infoTabs {
    width: 100%;
    height: 100%;
}

.unity-tab-view__content-viewport {
    height: 10%;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgb(134, 134, 134);
    border-bottom-left-radius: 10px;
}

#unity-tab-view__header-container {
    width: 100%;
    height: 90%;
    flex-direction: row;
}

#unity-tab__header {
    height: 100%;
    justify-content: center;
    align-items: center;
    flex-grow: 1;
    font-size: 30px;
    border-radius: 10px;
    padding: 0;
    margin-right: 10px;
    margin-left: 10px;
}

#unity-tab__header-underline {
    width: 0%;
}

.unity-tab-view__next-button {
    display: none;
}

.unity-tab-view__previous-button {
    display: none;
}

.unity-tab-view__content-container {
    height: 90%;
    width: 100%;
    margin-top: 20px;
}

#unity-tab__content-container {
    height: 100%;
    width: 100%;
}

.unity-tab {
    width: 100%;
    height: 100%;
}

.evolutions-container {
    width: 100%;
    height: 100%;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    background-color: rgb(134, 134, 134);
    border-radius: 23px;
}

.evolution-card-container {
    width: 33%;
    height: 95%;
    align-items: center;
    justify-content: center;
}

.small-evolution-card-container {
    width: 18%;
    height: 37%;
}

.empty-container {
    border-width: 5px;
    border-color: rgb(0, 0, 0);
    border-radius: 43px;
    background-image: resource("Sprites/backCover");
}

.arrow {
    width: 5%;
    height: 10.5%;
    border-width: 3px;
    border-color: rgb(118, 178, 192);
    border-radius: 35px;
    margin-left: 1%;
    margin-right: 1%;
    background-image: resource("Sprites/right-arrow_5344938");
    background-color: rgb(255, 197, 0);
}
