<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/USS/FriendSelectionDialogUSS.uss?fileID=7433441132597879392&amp;guid=2e69be989e26c9c43b0d7429522fadd1&amp;type=3#FriendSelectionDialogUSS"/>
    <ui:VisualElement name="overlay" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.49); display: none; align-items: center; justify-content: center; flex-direction: column; width: auto; height: auto;">
        <ui:VisualElement name="" style="flex-grow: 0; width: 28%; height: 50%; background-color: rgb(66, 73, 91); border-left-width: 3px; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); margin-left: 0; align-items: center; justify-content: flex-start; align-content: auto; border-top-right-radius: 45px; border-bottom-right-radius: 45px; flex-shrink: 0; border-top-left-radius: 45px; border-bottom-left-radius: 45px; border-top-width: 3px; border-right-width: 3px; border-bottom-width: 3px;">
            <ui:Label text="SELECT FRIEND" name="selectFriendLabel" style="unity-font-style: bold; font-size: 60px; color: rgb(255, 255, 255); margin-bottom: 15px; align-self: auto; justify-content: center; align-items: center; margin-top: 30px; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; white-space: normal; -unity-text-align: middle-center; margin-right: 0; margin-left: 0;">
                <Bindings>
                    <UnityEngine.Localization.LocalizedString property="text" table="GUID:fa451ded8096eb749bdc86ea6ed569b7" entry="Id(28255074909618176)"/>
                </Bindings>
