.main-content {
    width: 100%;
    height: 100%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    flex-grow: 1;
    background-color: var(--bg-start-play-scene);
    padding: 0;
}

.button {
    position: absolute; 
    justify-content: center; 
    align-items: center; 
    background-color: transparent; 
    border-width: 0;
    margin: 0; 
    padding: 0; 
}

.single-player-button {
    width: 700px; 
    height: 350px; 
    top: 124px; 
    left: 631px; 
}

.multy-player-button {
    width: 700px; 
    height: 350px;
    top: 393px; 
    left: 631px; 
}

.bestiary-button {
    width: 576px; 
    height: 622px; 
    top: 122px; 
    left: 1363px; 
}

.label-button {
    color: rgb(255, 255, 255); 
    font-size: 70px; 
}

.multy-player-button .label-button{
    top: 20px;
}