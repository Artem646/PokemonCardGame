            <ui:VisualElement style="flex-grow: 0; flex-direction: column; width: 100%; height: 20%; margin-bottom: 40px;">
                <ui:Label text="Room name:" name="RoomNameLabel" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; font-size: 35px; color: rgb(255, 255, 255); -unity-text-align: middle-center; height: 50%;">
                    <Bindings>
                        <UnityEngine.Localization.LocalizedString property="text" table="GUID:fa451ded8096eb749bdc86ea6ed569b7" entry="Id(28255077321342976)"/>
                    </Bindings>
                </ui:Label>
                <ui:TextField name="roomNameTextField" label="" value="" style="width: 90%; color: white; font-size: 30px; margin-bottom: 0; height: 50%; margin-top: 0; margin-right: 0; margin-left: 0; border-top-left-radius: 15px; border-top-right-radius: 15px; border-bottom-right-radius: 15px; border-bottom-left-radius: 15px; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0); align-self: center;"/>
            </ui:VisualElement>
            <ui:VisualElement style="flex-grow: 0; flex-direction: row; width: 100%; height: 17%; margin-bottom: 40px; margin-top: 0; margin-right: 0; margin-left: 0; justify-content: space-between;">
                <ui:DropdownField name="friendSelectField" label="Колода" style="width: 55%; margin-bottom: 0; color: white; unity-font-style: normal; background-color: rgba(51, 51, 51, 0); border-radius: 4px; height: 100%; margin-top: 0; margin-right: 0; margin-left: 0; font-size: 40px; -unity-text-align: middle-center; border-top-right-radius: 30px; border-top-left-radius: 30px; border-bottom-right-radius: 30px; border-bottom-left-radius: 30px; align-self: flex-start; left: 35px;"/>
                <ui:Toggle label="Spectator" name="spectatorToggle" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; right: 6px; height: 100%; width: 255px; align-items: center; justify-content: center; flex-direction: column; flex-wrap: nowrap; font-size: 30px; align-self: auto; color: rgb(255, 255, 255);">
