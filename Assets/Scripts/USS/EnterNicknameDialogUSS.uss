#unity-text-input {
    background-color: rgb(115, 97, 97);
    margin: 0;
    padding: 0;
    height: 100%;
    font-size: 55px;
    color: rgb(255, 255, 255);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    -unity-text-align: middle-center;
}
